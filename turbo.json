{
  "$schema": "https://turbo.build/schema.json",
  // Env vars are hashed into the task cache key AND, because turbo 2 defaults
  // to `strict` env mode, they are the ONLY vars a task's command receives.
  // Anything the app or the test suite reads from process.env must therefore be
  // declared here or it silently arrives undefined.
  "globalEnv": ["NODE_ENV", "CI"],
  "tasks": {
    "build": {
      // `^build` = build every upstream workspace dependency first. Nothing
      // depends on anything yet (apps/legacy is self-contained and the
      // packages/* are empty), but wiring it now means the convex/ui/utils
      // extractions land without touching this file.
      "dependsOn": ["^build"],
      "env": [
        "NEXT_PUBLIC_*",
        "CONVEX_*",
        "MAGIC_LINK_HMAC_KEY",
        "SESSION_SECRET",
        "LEARNER_JWT_SECRET",
        "EMAIL_*",
        "RESEND_API_KEY",
        "MP_*",
        "ZEPHYRA_PUBLIC_URL",
        "DEV_ADMIN_DEFAULT_PASSWORD"
      ],
      "outputs": [".next/**", "!.next/cache/**", "dist/**"]
    },
    "lint": {
      "dependsOn": ["^lint"]
    },
    "typecheck": {
      // Three entries, three distinct jobs — none is redundant:
      //
      // "build"      (NO caret) = this package's OWN build must finish first.
      //              Load-bearing, not cosmetic: tsconfig.json includes
      //              ".next/types/**/*.ts", which `next build` GENERATES. The
      //              caret means "upstream workspace dependencies only", and
      //              apps/legacy has none, so with only carets nothing ordered
      //              build before typecheck inside the same package and turbo
      //              ran them concurrently — tsc read .next/types while next
      //              was rewriting it, yielding ~66 spurious
      //              "error TS6053: File '.next/types/.../page.ts' not found".
      //              That made `turbo run typecheck build` a coin flip: green
      //              or red depending on interleaving. The caret cannot express
      //              a same-package edge; only the un-carated form can.
      // "^build"     = upstream packages that EMIT must emit before a consumer
      //              is typechecked. Transitively implied by "build" here, but
      //              kept explicit for the case of a workspace that has a
      //              typecheck script and no build script of its own.
      // "^typecheck" = upstream source-exported (non-emitting) packages.
      //
      // Consequence to know: `turbo run typecheck` now triggers a build. That
      // is a cost, and also a correctness gain — before this, a fresh checkout
      // had no .next at all, so the ".next/types/**" glob matched nothing and
      // the generated route types were never actually typechecked.
      "dependsOn": ["build", "^build", "^typecheck"],
      "outputs": ["tsconfig.tsbuildinfo"]
    },
    "test": {
      "dependsOn": ["^build"],
      "env": [
        "MAGIC_LINK_HMAC_KEY",
        "SESSION_SECRET",
        "LEARNER_JWT_SECRET",
        "E2E_*",
        "NEXT_PUBLIC_*"
      ]
      // No `outputs`: `vitest run` writes no artifacts (coverage is not
      // enabled), and declaring one turbo cannot find warns on every run.
    },
    "dev": {
      "cache": false,
      "persistent": true
    }
  }
}
