{
  "$schema": "https://turbo.build/schema.json",
  // Env vars are hashed into the task cache key AND, because turbo 2 defaults
  // to `strict` env mode, they are the ONLY vars a task's command receives.
  // Anything the app or the test suite reads from process.env must therefore be
  // declared here or it silently arrives undefined.
  "globalEnv": ["NODE_ENV", "CI"],
  "tasks": {
    "build": {
      // `^build` = build every upstream workspace dependency first. Since M2
      // the three apps all depend on @zephyra/convex, @zephyra/ui and
      // @zephyra/utils, so this edge is live (the packages are SOURCE-exported
      // and emit nothing, so it is a no-op in practice — but it is what makes an
      // emitting package correct the day one is added). Updated at T-fe-009,
      // which retired the self-contained apps/legacy this comment described.
      "dependsOn": ["^build"],
      "env": [
        "NEXT_PUBLIC_*",
        "CONVEX_*",
        "MAGIC_LINK_HMAC_KEY",
        "SESSION_SECRET",
        "LEARNER_JWT_SECRET",
        "EMAIL_*",
        "RESEND_API_KEY",
        "MP_*",
        // Academia's origin as the Convex backend addresses it (buyer email +
        // MercadoPago back_urls). ZEPHYRA_PUBLIC_URL is the deprecated alias
        // still honoured until the deployments are updated at M6 — both are
        // declared so neither arrives undefined under envMode: strict.
        "ZEPHYRA_ACADEMIA_URL",
        "ZEPHYRA_PUBLIC_URL",
        "DEV_ADMIN_DEFAULT_PASSWORD"
      ],
      "outputs": [".next/**", "!.next/cache/**", "dist/**"]
    },
    "lint": {
      "dependsOn": ["^lint"]
    },
    "typecheck": {
      // NO same-package dependency on `build`, and that is deliberate.
      //
      // There WAS a real race here: tsconfig.json includes
      // ".next/types/**/*.ts" (Next.js adds that entry itself), those files are
      // generated by `next build`, and `^build`/`^typecheck` only order
      // UPSTREAM workspaces — the caret cannot express a same-package edge. So
      // `turbo run typecheck build` ran both concurrently in one app workspace and
      // tsc read .next/types while next rewrote it, giving ~66 spurious
      // "error TS6053: File '.next/types/.../page.ts' not found". Green or red
      // depending on interleaving.
      //
      // Adding the un-carated "build" fixes the ordering but is the WRONG shape
      // for this repo: it forces `next build` into the CI typecheck job, and
      // this app cannot be built without NEXT_PUBLIC_CONVEX_URL — the SCORM
      // asset-proxy route constructs a Convex client at module scope, so page
      // data collection fails with "Client created with undefined deployment
      // address". That is precisely why CI has no build job.
      //
      // Instead the task is HERMETIC: it runs against tsconfig.typecheck.json,
      // which drops ".next/types/**" and excludes ".next". typecheck now reads
      // only checked-in source, shares no file with build, and the race is
      // impossible BY CONSTRUCTION rather than merely ordered — while CI stays
      // build-free and fast. See any app's tsconfig.typecheck.json (the original
      // was apps/legacy's, retired at T-fe-009; `git log --follow` has it).
      //
      // The carets remain for the genuine upstream cases in M2: an emitting
      // package must emit before a consumer is typechecked (`^build`), and a
      // source-exported one needs only its own typecheck (`^typecheck`).
      "dependsOn": ["^build", "^typecheck"],
      "outputs": ["*.tsbuildinfo"]
    },
    "test": {
      "dependsOn": ["^build"],
      "env": [
        "MAGIC_LINK_HMAC_KEY",
        "SESSION_SECRET",
        "LEARNER_JWT_SECRET",
        "E2E_*",
        "NEXT_PUBLIC_*"
      ]
      // No `outputs`: `vitest run` writes no artifacts (coverage is not
      // enabled), and declaring one turbo cannot find warns on every run.
    },
    "dev": {
      "cache": false,
      "persistent": true
    }
  }
}
