# @zephyra/convex — local env for the Convex CLI.
#
# WHY THIS FILE EXISTS. The Convex CLI resolves both the functions directory
# (./convex) and its credentials relative to the CURRENT WORKING DIRECTORY. Now
# that the backend lives here instead of in apps/legacy, `convex dev` /
# `convex codegen` must be run from this package — and it reads CONVEX_DEPLOYMENT
# from THIS directory's .env.local, not from apps/legacy/.env.local.
#
# So the deployment identity is currently duplicated across two gitignored
# files: apps/legacy/.env.local (what `next build`/`next dev` reads for
# NEXT_PUBLIC_CONVEX_URL) and this one (what the CLI reads). Keep them pointing
# at the SAME deployment or the app will talk to one backend while you push
# functions to another. Collapsing the two into one root-level env file is a
# deliberate non-goal of the extraction task; revisit when the per-app Vercel
# projects are wired.
#
# Copy to .env.local (gitignored) and fill from the Convex dashboard, or let
# `npx convex dev` write it for you on first run.

# Written by `npx convex dev` on first run. Shared dev backend for the team.
CONVEX_DEPLOYMENT=dev:xxx

# Not read by the CLI itself, but keeping them here lets you sanity-check that
# this package and apps/legacy agree on the deployment.
NEXT_PUBLIC_CONVEX_URL=https://xxx.convex.cloud
NEXT_PUBLIC_CONVEX_SITE_URL=https://xxx.convex.site
