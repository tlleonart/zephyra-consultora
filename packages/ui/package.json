{
  "name": "@zephyra/ui",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./providers/ConvexProvider": {
      "types": "./src/providers/ConvexProvider.tsx",
      "default": "./src/providers/ConvexProvider.tsx"
    },
    "./providers/ToastProvider": {
      "types": "./src/providers/ToastProvider.tsx",
      "default": "./src/providers/ToastProvider.tsx"
    },
    "./styles/variables.css": "./src/styles/variables.css",
    "./styles/globals.css": "./src/styles/globals.css",
    "./styles/theme-academia.css": "./src/styles/theme-academia.css"
  },
  "scripts": {
    "lint": "eslint .",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@zephyra/convex": "workspace:*",
    "@zephyra/utils": "workspace:*",
    "convex": "^1.17.4",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "styled-jsx": "5.1.6"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.2.0",
    "@types/react": "^19.0.2",
    "@types/react-dom": "^19.0.2",
    "eslint": "^9.17.0",
    "eslint-config-next": "^15.1.0",
    "typescript": "^5.7.2"
  }
}
