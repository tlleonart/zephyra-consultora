# apps/backoffice — staff-only CMS + admin console (backoffice.zephyraconsultora.com).
#
# This app carries the ADMIN session only. LEARNER_JWT_SECRET and
# MAGIC_LINK_HMAC_KEY must NEVER appear here: distinct secrets per surface are
# the cross-surface anti-escalation boundary (domain-boundaries v1.1 §4). If a
# change appears to need one, the change belongs in apps/academia.

# Convex — every admin list/form reads and writes through useQuery/useMutation,
# and @zephyra/ui/providers/ConvexProvider builds a ConvexReactClient at MODULE
# scope, so `next build` needs this to be a syntactically valid URL.
NEXT_PUBLIC_CONVEX_URL=https://xxx.convex.cloud

# Admin session signing (features/auth/lib/session.ts). Resolution is LAZY and
# FAILS CLOSED in production: with NODE_ENV=production and this unset, signing
# throws instead of silently falling back to the dev secret. Do not set a
# placeholder in a production environment — that would mask the guard.
SESSION_SECRET=change-me-in-every-real-environment

# Password reset mail (features/auth/actions/password-reset.ts).
# PRIMARY: Resend. FALLBACK: SMTP, used only when RESEND_API_KEY is absent.
RESEND_API_KEY=re_xxx
EMAIL_FROM=Zephyra <no-reply@zephyraconsultora.com>
EMAIL_USER=tu-cuenta-smtp@example.com
EMAIL_PASSWORD=tu-password-smtp

# THIS APP'S OWN ABSOLUTE ORIGIN. REQUIRED; there is no fallback (M4).
# Builds the password-reset link in the email body. /reset-password is served by
# THIS app and is not in the M6 301 map (boundaries v1.1 §3.1), so the value must
# name backoffice.* explicitly. Read through requireOrigin() from @zephyra/utils,
# which throws when unset — this line previously interpolated `undefined` into
# the email, mailing admins a dead link.
NEXT_PUBLIC_APP_URL=https://backoffice.zephyraconsultora.com
