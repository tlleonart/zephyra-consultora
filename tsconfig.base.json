{
  "$schema": "https://json.schemastore.org/tsconfig",
  // Shared TypeScript baseline for every workspace. These are the exact
  // compilerOptions the single-app tsconfig.json carried before the monorepo
  // split — nothing tightened, nothing relaxed. Workspace-specific concerns
  // (the `next` plugin, `paths`, `include`/`exclude`) stay in each workspace's
  // own tsconfig.json so non-Next packages can extend this file too.
  "compilerOptions": {
    "target": "ES2017",
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "preserve",
    "incremental": true
  }
}
