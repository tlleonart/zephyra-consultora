# Convex (auto-generated by npx convex dev)
CONVEX_DEPLOYMENT=dev:xxx
NEXT_PUBLIC_CONVEX_URL=https://xxx.convex.cloud

# Email: Nodemailer + Ferozo SMTP. Used by /api/send-mail (contact form), password-reset, and learner magic-link emails.
EMAIL_USER=tu-cuenta-smtp@example.com
EMAIL_PASSWORD=tu-password-smtp

# Auth — admin
SESSION_SECRET=tu-secret-de-32-caracteres-minimo

# argon2id password hashing (used from Sprint 1 onwards)
# (argon2id has no env config in default mode; OWASP 2024 params hardcoded in convex/model/passwords.ts — see B01)

# HMAC key for opaque tokens (magic-link, password reset migration). Generate via: openssl rand -hex 32
MAGIC_LINK_HMAC_KEY=replace-with-32-byte-hex-string

# Distinct JWT signing key for learner sessions (session-learner cookie). Generate via: openssl rand -hex 32
LEARNER_JWT_SECRET=replace-with-32-byte-hex-string

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000
